@model List<WebsiteBanRuouVang.Models.Departments>

@{
    ViewBag.Title = "Danh mục sản phẩm";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
    var cookie = Context.Request.Cookies["auth"];
    ViewBag.Username = cookie.Value;
}


<div class="manage-product">
    <div class="manage-product-header">
        <h2 class="manage-product-header-h">Danh mục sản phẩm</h2>
        @using (Html.BeginForm("Index", "Departments", FormMethod.Get, new { id = "myForm", @class = "manage-product-sort" }))
        {
            <p>
                @Html.DropDownList("sortOrder", new List<SelectListItem> {
                    new SelectListItem {Text="Sắp xếp theo Tên",Value="Name"},
                    new SelectListItem {Text="Sắp xếp theo Id",Value="DepId"}

                }, "Chọn cách sắp xếp!")
            </p>
        }
    </div>

    <div class="manage-product-content">
        <table class="table table-Primary table-striped manage-product-content-table manage-dep-content-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Tên</th>
                    <th>Sửa</th>
                    <th>Xoá</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(row => item.DepId)</td>
                        <td>@Html.DisplayFor(row => item.Name)</td>
                        <td><a href="/Departments/edit/@item.DepId">Sửa</a></td>
                        <td><a href="/Departments/delete/@item.DepId">Xoá</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="manage-product-add">
        <button>
            <a href="/departments/create">
                <i class="fa-solid fa-circle-plus"></i>
                <span>Thêm</span>
            </a>
        </button>
    </div>
</div>

<script>
    $(function () {
        $('#sortOrder').change(function () {
            $('#myForm').submit();
        });
    })
</script>

