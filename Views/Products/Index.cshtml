@model List<WebsiteBanRuouVang.Models.Products>

@{
    ViewBag.Title = "Sản phẩm";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
    var cookie = Context.Request.Cookies["auth"];
    ViewBag.Username = cookie.Value;
}

<div class="row">
    <div class="col-sm-3">
        <div class="p-3" style="">
            <center>
                <h5>
                    DANH MỤC
                </h5>
                <hr color="#d81159" width="150px" size="6px" align="left" />
            </center>


            <div id="accordion">
                @foreach (var danhmuc in ViewBag.DanhMuc)
                {
                    <div class="list-group">
                        <a href="/Products/Index?categoryId=@danhmuc.DepId" class="list-group-item list-group-item-action list-group-item-light highlight-item">@danhmuc.Name</a>
                    </div>
                }

            </div>
        </div>
    </div>
    <div class="col-sm-9">
        <div class="p-3">
            @if (!string.IsNullOrEmpty(ViewBag.SelectedCategory))
            {
                <h3 class="category-product-heading">@ViewBag.SelectedCategory</h3>
            }
            else
            {
                <h3 class="category-product-heading">TẤT CẢ SẢN PHẨM</h3>
            }
                <div class="text-right mb-2 category-product-sort">
                    <a href="/Products/Index?categoryId=@ViewBag.CurrentDeptID&amp;search=@ViewBag.Search&amp;page=@ViewBag.Page&amp;sortBy=Name&amp;sortOrder=@(ViewBag.SortBy == "Name" && ViewBag.SortOrder == "asc" ? "desc" : "asc")" class="btn btn-sm btn-info mr-2">Sắp xếp theo tên</a>
                    <a href="/Products/Index?categoryId=@ViewBag.CurrentDeptID&amp;search=@ViewBag.Search&amp;page=@ViewBag.Page&amp;sortBy=Price&amp;sortOrder=@(ViewBag.SortBy == "Price" && ViewBag.SortOrder == "asc" ? "desc" : "asc")" class="btn btn-sm btn-info mr-2 ">Sắp xếp theo giá</a>
                </div>
                @*<hr color="#d81159" width="250px" size="6px" align="left" />*@
            <div class="category-product">
                @foreach (var item in Model)
                {
                    <a href="/Products/Details/@item.Id?categoryId=@item.DepId">
                        <div class="card1">
                            <div class="category-product-img-cover">
                                <img src="~/image/@item.Image" class="card-img-top1" alt="Product Image">
                            </div>
                            <div class="card-body1">
                                <h5 class="card-title">@item.Name</h5>
                                <p class="card-text" style="color:red">@item.Price.ToString("N0")</p>
                            </div>
                            <div class="add-cart">
                                <button class="btn btn-info"><a href="/carts/add/@item.Id">Thêm vào giỏ hàng</a></button>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<tr>
    <td colspan="9">
        @{
            int PrevPage = ViewBag.Page - 1;
            if (PrevPage <= 0)
            {
                PrevPage = 1;
            }
            int NextPage = ViewBag.Page + 1;
            if (NextPage > ViewBag.NoOfPages)
            {
                NextPage = ViewBag.NoOfPages;
            }
        }
        <ul class="pagination justify-content-center">
            @if (ViewBag.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="/Products/Index?categoryId=@ViewBag.CurrentDeptID&search=@ViewBag.Search&page=@PrevPage">
                        Prev
                    </a>
                </li>
            }
            @for (int i = 0; i < ViewBag.NoOfPages; i++)
            {
                if (i + 1 == ViewBag.Page)
                {
                    <li class="page-item active">
                        <a class="page-link" href="/Products/Index?categoryId=@ViewBag.CurrentDeptID&search=@ViewBag.Search&page=@(i + 1)">
                            @(i + 1)
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="/Products/Index?categoryId=@ViewBag.CurrentDeptID&search=@ViewBag.Search&page=@(i + 1)">
                            @(i + 1)
                        </a>
                    </li>
                }
            }
            @if (ViewBag.Page < ViewBag.NoOfPages)
            {
                <li class="page-item">
                    <a class="page-link" href="/Products/Index?categoryId=@ViewBag.CurrentDeptID&search=@ViewBag.Search&page=@NextPage">
                        Next
                    </a>
                </li>
            }
        </ul>
    </td>
</tr>









