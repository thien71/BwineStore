@{
    var cookie = Context.Request.Cookies["auth"]; 
}
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    <meta charset="utf-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <link rel="stylesheet" href="./css/reset.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
    <link rel="stylesheet" href="~/css/style.css">
    <script src="https://code.jquery.com/jquery-3.7.1.slim.js" integrity="sha256-UgvvN8vBkgO0luPSUl2s8TIlOSYRoGFAX4jlCIm9Adc=" crossorigin="anonymous"></script>
    <script src="https://kit.fontawesome.com/4e5999a8c6.js" crossorigin="anonymous"></script>

    <style>
    </style>

    <script type="text/javascript">
        window.onload = function () {
            setTimeout(switchImage, 3000);
        }
        var current = 0;
        var numIMG = 2;
        function switchImage() {
            current++;
            document.images['myimage'].src = '/image/image' + current + '.jpg';
            if (current === numIMG) {
                current = 0;
            }
            setTimeout(switchImage, 3000);
        }
    </script>
</head>
<body
    <div class="container">
        <header class="header">
            <div class="header-top">
                <ul class="header-top-list">
                    <li class="header-top-item">
                        <a class="navbar-brand" href="/Home/index">
                            <img class="navbar-logo" src="/image/logo.png" alt="Logo">
                        </a>
                    </li>
                    <li class="header-top-item">
                        <form class="d-flex flex-row align-items-center flex-wrap header-form" action="/Products/index">
                            @*<label for="Search" class="mx-2 my-1">Search</label>*@

                            <div class="header-search">
                                <input type="Search"
                                       class="form-control w-auto header-search-input"
                                       id="Search"
                                       name="Search"
                                       value="@ViewBag.Search"
                                       placeholder="Tìm kiếm" />
                                <button type="submit" class="header-search-button">
                                    <i class="fa-solid fa-magnifying-glass header-search-icon"></i>
                                </button>
                            </div>

                        </form>
                    </li>
                    <li class="header-top-item">
                        <ul class="header-sublist">
                            <li class="header-sublist-item">
                                @if (cookie != null)
                                {
                                    <div class="header-sublist-item-user">
                                        <img src="~/image/avatar_default.jpg">
                                        <span>@ViewBag.Username</span>
                                        <ul class="user-sublist">
                                            <li class="user-sublist-item">
                                                <a href="/Users/Logout" class="user-sublist-link">Đăng xuất</a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <a href="/Users/Login" class="header-sublist-item-user nav-link">
                                        Đăng nhập
                                        @*<i class="fa-regular fa-user"></i>*@
                                    </a>
                                }
                            </li>

                            <li class="header-sublist-item">
                                @if (cookie != null)
                                {
                                    <a href="/carts/index">
                                        @*<img src="~/image/shopping-cart.png" style="height: 35px; margin: 10px; " />*@
                                        <i class="fa-solid fa-cart-shopping"></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="/Users/Login">
                                        <i class="fa-solid fa-cart-shopping"></i>
                                        @*<img src="~/image/shopping-cart.png" style="height:35px; margin: 10px;" />*@
                                    </a>
                                }
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
            <nav class="navbar navbar-expand-lg navbar-light bg-light">
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/products/index">Sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Sản phẩm khuyến mãi</a>
                        </li>

                        @if (cookie != null && @cookie.Value == "admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-item-down" href="#" id="navbarDropdown3" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Thông tin rượu
                                </a>
                                <ul class="subnav" aria-labelledby="navbarDropdown3">
                                    <li class="subnav-item">
                                        <a class="subnav-item-link" href="/brands">Thương hiệu</a>
                                    </li>
                                    <li class="subnav-item">
                                        <a class="subnav-item-link" href="/departments">Danh mục</a>
                                    </li>
                                    <li class="subnav-item">
                                        <a class="subnav-item-link" href="/products/about">Rượu</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="#">Thông tin</a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" href="#">Phụ kiện</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Liên hệ</a>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>

        <main>
            @*<div id="content" style="margin-top:-25px;background-color:aliceblue;min-height:1000px">*@
            <div id="content">
                <div class="right-section">

                @RenderBody()

                <div style="clear:both;"></div>
            </div>
        </main>

        <footer class="footer" style="background-color: #30336b; color: white">
            <div class="mt-5 p-4" style="background-color: #30336b">
                <div class="row">
                    <div class="col p-3">
                    <center>
                        <h6>Địa chỉ</h6>
                        <a>
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3833.7650506977716!2d108.20948967435464!3d16.07767738460302!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31421847b8d7ec71%3A0x7591c4b0240f6bc2!2zNDggQ2FvIFRo4bqvbmcsIFRoYW5oIELDrG5oLCBI4bqjaSBDaMOidSwgxJDDoCBO4bq1bmcgNTUwMDAwLCBWaeG7h3QgTmFt!5e0!3m2!1svi!2s!4v1703146372984!5m2!1svi!2s" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </a>
                    </center>

                    </div>
                    <div class="col p-4">
                        <center>
                        <h6>LIÊN HỆ</h6>
                        <i class="fas fa-phone-alt" style="color: white;"></i>
                        <a>0382208154</a><br />
                        <i class="fas fa-envelope" style="color: white;"></i>
                        <a>Trường Đại Học Sư Phạm Kỹ Thuật Đà Nẵng</a><br />
                        <i class="fas fa-store" style="color: white;"></i>
                        <a>48 Cao Thắng</a>
                        </center>
                    </div>
                    <div class="col p-3">
                        <center>
                        <h6>PHƯƠNG THỨC THANH TOÁN</h6>
                        <img src="~/image/tt1.png" />
                        <img src="~/image/tt2.png" />
                        <img src="~/image/tt3.png" />
                        </center>
                    </div>
                </div>
            </div>
        </footer>
    </div>


    @*/script/*@

    <script type="text/javascript" src="https://code.jquery.com/jquery-1.11.0.min.js"></script>
    <script type="text/javascript" src="https://code.jquery.com/jquery-migrate-1.2.1.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

    <script>
        $(document).ready(function () {
            $(".image-slider").slick({
                slidesToShow: 3,
                slidesToScroll: 1,
                infinite: true,
                arrows: true,
                draggable: false,
                prevArrow: `<button type='button' class='slick-prev slick-arrow'><ion-icon name="arrow-back-outline"></ion-icon></button>`,
                nextArrow: `<button type='button' class='slick-next slick-arrow'><ion-icon name="arrow-forward-outline"></ion-icon></button>`,
                dots: true,
                responsive: [
                    {
                        breakpoint: 1025,
                        settings: {
                            slidesToShow: 3,
                        },
                    },
                    {
                        breakpoint: 480,
                        settings: {
                            slidesToShow: 1,
                            arrows: false,
                            infinite: false,
                        },
                    },
                ],
                autoplay: true,
                autoplaySpeed: 1500,
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.0.1/dist/gsap.min.js"></script>
    <script src="~/javaScript/JavaScript.js"></script>

   </body>
</html>